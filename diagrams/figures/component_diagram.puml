skinparam componentStyle rectangle
skinparam backgroundColor #1a1a2e
skinparam component {
  BackgroundColor<<entry>> #1a5276
  FontColor #ffffff
  BorderColor #3498db
}
skinparam component {
  BackgroundColor<<service>> #1a6e3a
  FontColor #ffffff
  BorderColor #4ad990
}
skinparam component {
  BackgroundColor<<csmod>> #6c3483
  FontColor #ffffff
  BorderColor #af7ac5
}
skinparam component {
  BackgroundColor<<luamod>> #3a3a6c
  FontColor #ffffff
  BorderColor #7a7ad9
}
skinparam component {
  BackgroundColor<<entity>> #1a5c5c
  FontColor #ffffff
  BorderColor #4ad9d9
}
skinparam component {
  BackgroundColor<<game>> #7d3c1a
  FontColor #ffffff
  BorderColor #d97a4a
}
skinparam component {
  BackgroundColor<<def>> #5c5c1a
  FontColor #ffffff
  BorderColor #d9d94a
}
skinparam component {
  BackgroundColor<<view>> #5c3a3a
  FontColor #ffffff
  BorderColor #d97a7a
}
skinparam arrow {
  Color #8899aa
  FontColor #cccccc
}

' ========== 入口 ==========
package "🚀 入口层" as ENTRY {
  component AppMain as "AppMain\n- InitServices()\n- InitBusiness()" <<entry>>
}

' ========== Service 层 ==========
package "🔧 Service 常驻服务" as SVC {
  component ResourceMgr as "ResourceFormalManager\nAddressables 加载/缓存" <<service>>
  component LuaMgr as "LuaManager\nXLua VM / 模块桥接" <<service>>
  component NetMgr as "NetworkManager\n双Socket / 消息分发" <<service>>
  component BattleMgr as "BattleManager\n战斗域" <<service>>
  component SoundMgr as "SoundManager\nWwise" <<service>>
  component GMMgr as "GMManager" <<service>>
  component CameraMgr as "CameraManager\nStarsCamera" <<service>>
  component InputMgr as "InputManager" <<service>>
  component AtlasMgr as "AtlasManager" <<service>>
  component LangMgr as "LanguageManager" <<service>>
  component TimelineMgr as "TimelineManager" <<service>>
  component SceneMgr as "StarScenesManager\n场景加载" <<service>>
  component RenderMgr as "RenderManager\nURP画质" <<service>>
}

' ========== C# 模块 ==========
package "🔷 C# 业务模块 (<5000)" as CSMOD {
  component LoginMod as "LoginModule" <<csmod>>
  component StarWorldMod as "StarWorldModule" <<csmod>>
  component TriggerMod as "TriggerModule" <<csmod>>
  component InteractMod as "InterActionModule" <<csmod>>
  component RingTaskMod as "RingTaskModule" <<csmod>>
  component WorldMapMod as "WorldMapModule" <<csmod>>
  component EctypeMod as "EctypeModule" <<csmod>>
  component BattleZoneMod as "BattleZoneModule" <<csmod>>
  component TutorialMod as "TutorialModule" <<csmod>>
  component ScenePlayMod as "ScenePlayModule" <<csmod>>
}

' ========== Lua 模块组 ==========
package "🔶 Lua 业务模块 (>5000)" as LUAMOD {
  component LuaSocial as "社交组\nChat/Friend/Guild/Mail/Team" <<luamod>>
  component LuaEco as "经济组\nShop/Bag/Equip/Bank/Exchange" <<luamod>>
  component LuaAct as "活动组\nActivity/Event/DailyAct/DrawCard" <<luamod>>
  component LuaBat as "战斗组\nPvp/Arena/Tower/WildBoss" <<luamod>>
  component LuaChar as "养成组\nPartner/Talent/Inscription/Skill" <<luamod>>
  component LuaInfo as "信息组\nRank/BeginnerTarget/Tips" <<luamod>>
  component LuaOther as "其他\nTask/LivingSkills/Treasure/Login" <<luamod>>
}

' ========== Entity 系统 ==========
package "🧬 Entity 系统" as ENT {
  component EntityFactory as "EntityFactory\n[static] + Recycler" <<entity>>
  component ViewFactory as "ViewFactory\n[static] Entity→View" <<entity>>
  component EntityRemote as "EntityRemoteDynamic\n→ AOIEntity\n→ Hero/Monster/Partner" <<entity>>
  component EntityLocal as "EntityLocalDynamic\n宝箱/传送门/悬赏" <<entity>>
  component EntityStatic as "EntityLocalStatic\n+ EntityRemoteStatic" <<entity>>
}

' ========== Game 运行时 ==========
package "🎮 Game 核心运行时" as GAME {
  component Player as "Player\nEntityCtrlBase" <<game>>
  component Skill as "Skill 系统\nTimeline/Buff/Passive" <<game>>
  component Camera as "StarsCamera" <<game>>
  component Map as "Map/FindPath" <<game>>
}

' ========== Lua View ==========
package "🖥️ Lua View 层" as VIEW {
  component ViewWin as "UIWindow\n443个窗口" <<view>>
  component ViewWgt as "UIWidget\n103个挂件" <<view>>
}

' ========== 定义层 ==========
package "📐 StarProjectDef" as DEF {
  component Enums as "GameEnums (91KB)" <<def>>
  component Config as "GameConfig\nGlobalConfig" <<def>>
  component ModuleDef as "ModuleDef\n5000分界线" <<def>>
  component UIDef as "UIDef" <<def>>
  component WrapData as "WrapData\n350+结构体" <<def>>
}

' ========== 关系 ==========
AppMain --> ResourceMgr : InitServices
AppMain --> LuaMgr
AppMain --> NetMgr
AppMain --> BattleMgr
AppMain --> SoundMgr
AppMain --> GMMgr
AppMain --> CameraMgr
AppMain --> InputMgr
AppMain --> SceneMgr
AppMain --> RenderMgr

AppMain --> LoginMod : InitBusiness
AppMain --> StarWorldMod

LoginMod ..> ModuleDef : 使用

EntityFactory --> EntityRemote : 创建
EntityFactory --> EntityLocal
EntityFactory --> EntityStatic
EntityFactory --> ViewFactory : 关联

ViewFactory --> ViewWin : Lua View绑定
ViewFactory --> ViewWgt

LuaMgr --> LuaSocial : 加载Lua模块
LuaMgr --> LuaEco
LuaMgr --> LuaAct
LuaMgr --> LuaBat
LuaMgr --> LuaChar
LuaMgr --> LuaInfo
LuaMgr --> LuaOther

LuaSocial --> ViewWin : UI操作
LuaEco --> ViewWin
LuaAct --> ViewWin
LuaBat --> ViewWin
LuaChar --> ViewWin
LuaInfo --> ViewWin

ResourceMgr ..> ViewWin : 资源加载
ResourceMgr ..> ViewWgt

NetMgr ..> LoginMod : 网络消息
NetMgr ..> LuaEco
NetMgr ..> LuaBat

EntityRemote --> Skill : 技能系统
EntityRemote --> Player : 控制器
Player --> Camera : 摄像机跟随
Player --> Map : 寻路/地图

Def ..> AppMain : 共享引用
Def ..> ResourceMgr
Def ..> NetMgr
Def ..> CSMOD
Def ..> LUAMOD
Def ..> ENT
Def ..> GAME

@enduml
