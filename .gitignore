# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/

# SVN metadata must never be committed to Git
.svn/

# IDE, local tools, and generated project files
.vs/
.vscode/
.codegraph/
.vsconfig
*.csproj
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.suo

# Unity metadata is intentionally excluded from this code-only Git mirror
*.meta

# Secrets, binaries, backups, and archives
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.dll
*.exe
*.apk
*.aab
*.rar
*.zip
*.7z
*.bak
*.backup

# Code-only Git mirror policy:
# ignore everything by default, then re-include source files for local search.
/*

# Repository metadata and minimal Unity restore hints
!/.gitignore
!/Packages/
/Packages/*
!/Packages/manifest.json
!/Packages/packages-lock.json
!/ProjectSettings/
/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt
# Source files should stay visible to Codex/Git file search.
!/Assets/
/Assets/**
!/Assets/**/
!/LocalPackages/
/LocalPackages/**
!/LocalPackages/**/
!/Packages/
/Packages/**
!/Packages/**/
!/Packages/manifest.json
!/Packages/packages-lock.json

!/Assets/**/*.cs
!/Assets/**/*.asmdef
!/Assets/**/*.asmref
!/Assets/**/*.rsp
!/Assets/**/*.shader
!/Assets/**/*.hlsl
!/Assets/**/*.cginc
!/Assets/**/*.compute
!/LocalPackages/**/*.cs
!/LocalPackages/**/*.asmdef
!/LocalPackages/**/*.asmref
!/LocalPackages/**/*.rsp
!/LocalPackages/**/*.shader
!/LocalPackages/**/*.hlsl
!/LocalPackages/**/*.cginc
!/LocalPackages/**/*.compute
!/Packages/**/*.cs
!/Packages/**/*.asmdef
!/Packages/**/*.asmref
!/Packages/**/*.rsp
!/Packages/**/*.shader
!/Packages/**/*.hlsl
!/Packages/**/*.cginc
!/Packages/**/*.compute

